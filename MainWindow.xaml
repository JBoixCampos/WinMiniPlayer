<Window x:Class="MiniPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows MiniPlayer"
        Width="300" Height="44"
        Left="-10000" Top="-10000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root"
            CornerRadius="10"
            Background="#E61F1F1F"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            Padding="6,5"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseMove="Root_MouseMove"
            MouseLeftButtonUp="Root_MouseLeftButtonUp"
            LostMouseCapture="Root_LostMouseCapture"
            MouseWheel="Root_MouseWheel">

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Position">
                    <MenuItem x:Name="PosAboveItem" Header="Above taskbar"
                              IsCheckable="True" Click="PosAbove_Click" />
                    <MenuItem x:Name="PosOnItem" Header="On taskbar"
                              IsCheckable="True" Click="PosOn_Click" />
                </MenuItem>
                <MenuItem x:Name="DraggableItem" Header="Draggable"
                          IsCheckable="True" Click="Draggable_Click" />
                <Separator />
                <MenuItem x:Name="StartupItem" Header="Start with Windows"
                          IsCheckable="True" Click="StartupItem_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="ExitItem_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Artwork (ImageBrush on a rounded Border clips to the corner radius) -->
            <Border x:Name="ArtHost" Grid.Column="0"
                    Width="32" Height="32" CornerRadius="6"
                    Background="#22FFFFFF" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,6,0">
                <TextBlock x:Name="TitleText"
                           Foreground="#FFFFFFFF" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock x:Name="ArtistText"
                           Foreground="#9EFFFFFF" FontSize="11"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,1,0,0" />
            </StackPanel>

            <StackPanel x:Name="Transport" Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button Style="{StaticResource TransportButton}" Click="Prev_Click"
                        Content="&#xE892;" ToolTip="Previous" />
                <Button Style="{StaticResource TransportButton}" Click="PlayPause_Click" ToolTip="Play / Pause">
                    <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" />
                </Button>
                <Button Style="{StaticResource TransportButton}" Click="Next_Click"
                        Content="&#xE893;" ToolTip="Next" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
